// ─────────────────────────────────────────────────────────────────────────────
//  Sistema Central — esquema completo
//
//  Convenciones (docs/02-modelo-datos.md):
//    · PK           UUID v7 generado en la aplicación (ordenable por tiempo)
//    · Dinero       Decimal(14,4) — JAMÁS Float
//    · Cantidades   Decimal(14,3)
//    · Fechas       DateTime @db.Timestamptz(6), siempre UTC
//    · Borrado      deletedAt — nunca DELETE en tablas con historial
//    · Concurrencia version Int en entidades editables (If-Match)
//
//  Objetos que Prisma no modela y viven en migraciones SQL propias
//  (ver prisma/migrations/*_hardening/migration.sql):
//    · CHECK constraints (inventario, reservas, pagos, devoluciones)
//    · Columna generada qty_available — invisible al cliente, se lee con SQL crudo
//    · Índices únicos PARCIALES, GIN trigram y de texto completo
//    · Trigger de normalización del texto de búsqueda
//    · REVOKE UPDATE/DELETE sobre stock_ledger y audit_logs
//
//  ⚠ FLUJO DE MIGRACIONES — LEER ANTES DE TOCAR EL ESQUEMA
//
//  NO ejecutes `prisma migrate dev` a secas: propondría BORRAR los objetos de
//  arriba porque no sabe modelarlos. El flujo del proyecto es:
//
//      pnpm db:migrate:new -- --name <nombre>   # genera el SQL, NO lo aplica
//      (revisa y edita el SQL a mano si hace falta)
//      pnpm db:deploy                           # lo aplica
//
//  `db:deploy` usa `migrate deploy`, que aplica exactamente lo que dice el
//  archivo y nunca improvisa.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Runtime: rol pv_app, restringido (sin UPDATE/DELETE en ledger ni auditoría).
  url      = env("DATABASE_URL")
  // Migraciones y seed: rol pv_owner, dueño del esquema.
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
//  ENUMERADOS
// ═════════════════════════════════════════════════════════════════════════════

