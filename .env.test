# Entorno de PRUEBAS — se versiona a propósito: no contiene secretos reales.
# Usa una base de datos separada para que las pruebas nunca toquen datos de desarrollo.
NODE_ENV=test
TZ=UTC

POSTGRES_USER=pv_owner
POSTGRES_PASSWORD=pv_owner_local_dev
POSTGRES_DB=punto_venta_test
POSTGRES_PORT=5433
APP_DB_USER=pv_app
APP_DB_PASSWORD=pv_app_local_dev

DATABASE_URL="postgresql://pv_app:pv_app_local_dev@localhost:5433/punto_venta_test?schema=public"
DATABASE_MIGRATION_URL="postgresql://pv_owner:pv_owner_local_dev@localhost:5433/punto_venta_test?schema=public"

API_PORT=3001
API_PREFIX=api
API_URL=http://localhost:3001

JWT_ACCESS_SECRET=test_secret_de_acceso_solo_para_pruebas_32chars
JWT_REFRESH_SECRET=test_secret_de_refresco_solo_para_pruebas_32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
POS_SESSION_TTL=12h

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

ENCRYPTION_KEY=cHJ1ZWJhcy1jbGF2ZS1kZS1jaWZyYWRvLTMyYnl0ZXM=

CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10000
THROTTLE_AUTH_LIMIT=1000

OUTBOX_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100

LOG_LEVEL=silent
LOG_PRETTY=false

SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=Test.Admin123
SEED_ADMIN_NAME=Admin Pruebas
SEED_COMPANY_NAME=Distribuidora Pruebas
SEED_COMPANY_RFC=XAXX010101000
SEED_BRANCH_NAME=Sucursal Pruebas
SEED_BRANCH_CODE=T
SEED_TIMEZONE=America/Chihuahua
