# ─────────────────────────────────────────────────────────────────────────────
#  Maydek — variables de entorno
#
#  Copia este archivo a `.env` y ajusta los valores:
#      cp .env.example .env
#
#  NUNCA subas `.env` al repositorio. Este `.example` sí se versiona.
#  El API valida estas variables al arrancar: si falta una obligatoria o tiene
#  un valor inválido, el proceso NO inicia (mejor fallar al desplegar que a
#  media operación).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=production
TZ=UTC

# ── Base de datos ────────────────────────────────────────────────────────────
# DOS ROLES, a propósito (docs/06-seguridad.md):
#
#   pv_owner  dueño del esquema. Ejecuta migraciones. Es superusuario.
#   pv_app    rol de la APLICACIÓN. Restringido: NO tiene UPDATE ni DELETE
#             sobre stock_ledger ni audit_logs. Así, el "nada se borra" del
#             diseño lo impone PostgreSQL y no la disciplina del programador.
#
# Estos los consume docker-compose para crear el contenedor.
POSTGRES_USER=pv_owner
POSTGRES_PASSWORD=cambia_esta_contrasena_de_owner
POSTGRES_DB=punto_venta
POSTGRES_PORT=5433
APP_DB_USER=pv_app
APP_DB_PASSWORD=cambia_esta_contrasena_de_app

# Conexión que usa el API en tiempo de ejecución (rol restringido).
DATABASE_URL="postgresql://pv_app:cambia_esta_contrasena_de_app@localhost:5433/punto_venta?schema=public"

# Conexión que usan las migraciones y el seed (rol dueño).
DATABASE_MIGRATION_URL="postgresql://pv_owner:cambia_esta_contrasena_de_owner@localhost:5433/punto_venta?schema=public"

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_PREFIX=api
API_URL=https://api.tudominio.com

# ── Autenticación ────────────────────────────────────────────────────────────
# Genera secretos únicos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo 32 caracteres. El API se niega a arrancar con los valores de ejemplo en producción.
JWT_ACCESS_SECRET=desarrollo_cambia_este_secreto_de_acceso_min_32_chars
JWT_REFRESH_SECRET=desarrollo_cambia_este_secreto_de_refresco_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
POS_SESSION_TTL=12h

# Bloqueo progresivo por intentos fallidos
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Cifrado en reposo ────────────────────────────────────────────────────────
# Clave maestra para credenciales de integraciones y, más adelante, el CSD fiscal.
# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGVzYXJyb2xsby1jYW1iaWEtZXN0YS1jbGF2ZS0zMmI=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista blanca separada por comas. NUNCA "*" con credenciales.
CORS_ORIGINS=https://admin.tudominio.com,https://pos.tudominio.com

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=5

# ── Outbox (relay de eventos) ────────────────────────────────────────────────
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ── Semilla inicial ──────────────────────────────────────────────────────────
# Credenciales del primer administrador. Cámbialas antes del primer arranque real.
SEED_ADMIN_EMAIL=admin@distribuidora.local
SEED_ADMIN_PASSWORD=Admin.Cambiar123
SEED_ADMIN_NAME=Administrador
SEED_COMPANY_NAME=Distribuidora de Fajas
SEED_COMPANY_RFC=XAXX010101000
SEED_BRANCH_NAME=Tienda Principal
SEED_BRANCH_CODE=A
SEED_TIMEZONE=America/Mexico_City

# ── Frontends ────────────────────────────────────────────────────────────────
VITE_API_URL=https://api.tudominio.com/api/v1

# ── Redis (NO se usa en la Fase 1) ───────────────────────────────────────────
# Se activa en la Fase 10 con:  docker compose --profile queue up -d
# REDIS_URL=redis://localhost:6379
