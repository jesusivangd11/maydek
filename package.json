{
  "name": "punto-venta",
  "version": "0.1.0",
  "private": true,
  "description": "Maydek — Punto de Venta, Inventario y Administración",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:local-db": "node scripts/setup-postgres-local.mjs",
    "db:local:start": "node scripts/setup-postgres-local.mjs --start",
    "db:local:stop": "node scripts/setup-postgres-local.mjs --stop",
    "db:local:status": "node scripts/setup-postgres-local.mjs --status",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@pv/api",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres && node scripts/wait-for-db.mjs && pnpm --filter @pv/api db:deploy && pnpm --filter @pv/api db:seed",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @pv/api db:migrate",
    "db:deploy": "pnpm --filter @pv/api db:deploy",
    "db:seed": "pnpm --filter @pv/api db:seed",
    "db:seed:dev": "pnpm --filter @pv/api db:seed:dev",
    "db:studio": "pnpm --filter @pv/api db:studio",
    "db:verify": "pnpm --filter @pv/api db:verify",
    "db:backup": "node scripts/backup-db.mjs --verify",
    "db:backup:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/schedule-backup.ps1",
    "clean": "turbo run clean && rimraf node_modules",
    "dev:web": "turbo run dev --filter=@pv/web",
    "desktop": "pnpm --filter @pv/api build && pnpm --filter @pv/desktop dev",
    "desktop:start": "pnpm --filter @pv/desktop start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "semi": true
  }
}
